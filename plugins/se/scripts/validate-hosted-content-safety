#!/usr/bin/env bash
set -euo pipefail

# Check policy references and template paths; maintainers review the policy prose.

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd -P)
plugin_root=$(cd -- "$script_dir/.." && pwd -P)
owner="$plugin_root/references/hosted-content-safety.md"

fail() {
  echo "hosted-content-safety: $1" >&2
  exit 1
}

test -s "$owner" || fail "missing or empty canonical owner"

for relative in \
  skills/idea/SKILL.md \
  skills/spec/SKILL.md \
  skills/deliver/SKILL.md \
  skills/deliver/references/workers.md \
  skills/deliver-features/SKILL.md \
  skills/review-pr/SKILL.md \
  skills/idea/references/publishing.md \
  skills/spec/steps/save.md \
  skills/spec/references/github-output.md \
  skills/deliver-features/references/completion.md \
  skills/deliver-features/references/progress.md \
  skills/spec/templates/maintenance-changelog.md \
  skills/deliver-features/references/orchestration.md; do
  target="$plugin_root/$relative"
  rg -Fq -- "hosted-content-safety.md" "$target" || \
    fail "missing canonical route in $relative"
done

hosted_templates=(
  "$plugin_root/skills/idea/references/idea-template.md"
  "$plugin_root/skills/spec/templates/spec.md"
  "$plugin_root/skills/spec/templates/task.md"
  "$plugin_root/skills/spec/templates/maintenance-changelog.md"
)

if rg -n -- '/Users/|/home/|/private/|[A-Za-z]:[\\/]' "${hosted_templates[@]}"; then
  fail "hosted template contains a machine-specific absolute path"
else
  scan_status=$?
  [[ "$scan_status" == 1 ]] || fail "could not inspect every hosted template"
fi

echo "hosted-content-safety: ok"
